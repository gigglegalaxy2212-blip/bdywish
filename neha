# Floating hearts animation
def create_heart():
    x = random.randint(10, 580)
    y = 700

    symbols = ["❤️", "💕", "💖", "✨", "🌸"]
    symbol = random.choice(symbols)

    heart_id = canvas.create_text(
        x, y,
        text=symbol,
        font=("Arial", random.randint(15, 25))
    )

    def move():
        canvas.move(heart_id, 0, -4)

        coords = canvas.coords(heart_id)

        if coords and coords[1] > -30:
            root.after(40, move)
        else:
            canvas.delete(heart_id)

    move()

    root.after(500, create_heart)


# Heart beating animation
beat_state = True

def beat():
    global beat_state

    if beat_state:
        heart.config(font=("Arial", 100))
    else:
        heart.config(font=("Arial", 85))

    beat_state = not beat_state
    root.after(500, beat)


# Surprise button function
def open_surprise():
    surprise.pack(pady=10)
    button.config(
        text="Happy Birthday Neha! ❤️",
        state="disabled"
    )

    for i in range(60):
        root.after(i * 50, create_heart)


# Button
button = tk.Button(
    root,
    text="Open Your Surprise 💝",
    font=("Arial", 14, "bold"),
    bg="#ff176b",
    fg="white",
    activebackground="#ff83b2",
    activeforeground="white",
    relief="flat",
    padx=25,
    pady=12,
    cursor="hand2",
    command=open_surprise
)
button.pack(pady=20)

# Start animations
beat()
create_heart()

root.mainloop()
